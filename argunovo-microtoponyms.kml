<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document><Style id="strokeColor:56db40e6_strokeWidth:5"><LineStyle><color>e640db56</color><width>5</width></LineStyle></Style><Style id="fillColor:56db4099_strokeColor:56db40e6_strokeWidth:5"><LineStyle><color>e640db56</color><width>5</width></LineStyle><PolyStyle><color>9940db56</color><fill>1</fill><outline>1</outline></PolyStyle></Style><ExtendedData><Data name="creator"><value><![CDATA[Yandex Map Constructor]]></value></Data></ExtendedData><name><![CDATA[Карта микротопонимов к окрестностям аргуновских деревень]]></name><description><![CDATA[Составитель Н.В. Большакова, Илья Орлов (Лачуги)]]></description><Folder><Placemark><name/><description><![CDATA[Зубовка]]></description><styleUrl>#fillColor:56db4099_strokeColor:56db40e6_strokeWidth:5</styleUrl><Polygon><outerBoundaryIs><LinearRing><coordinates>38.97156558503947,55.96717887765 38.972735028169964,55.96748575662161 38.97108278741679,55.96936308068862 38.96985970010601,55.96902613182228 38.97156558503947,55.96717887765</coordinates></LinearRing></outerBoundaryIs></Polygon></Placemark><Placemark><name/><description><![CDATA[Лачуги. Историческое название деревни, которое существовало не менее 300 лет.]]></description><styleUrl>#fillColor:56db4099_strokeColor:56db40e6_strokeWidth:5</styleUrl><Polygon><outerBoundaryIs><LinearRing><coordinates>38.98487159068551,55.96876677051317 38.98401328380042,55.96924812836805 38.978589857172906,55.96763419161671 38.9738155251259,55.9660289332942 38.971321070742256,55.96948278812563 38.96952935511991,55.969127789466405 38.97245832736426,55.96567390278659 38.96545239741728,55.964368084484136 38.965709889483236,55.963802416762356 38.967276299547805,55.963567722396505 38.97392281348656,55.965162412421606 38.979314053606444,55.96648023853839 38.98487159068551,55.96876677051317</coordinates></LinearRing></outerBoundaryIs></Polygon></Placemark><Placemark><name/><description><![CDATA[Серёдка. Срединная часть старого порядка деревни. Концы указаны приблизительно.]]></description><styleUrl>#strokeColor:56db40e6_strokeWidth:5</styleUrl><LineString><coordinates>38.9713983548067,55.96498583507895 38.976365805902276,55.96617429300771</coordinates></LineString></Placemark><Placemark><name><![CDATA[168 Шубара]]></name><description><![CDATA[болото от речки Молодыни в сторону Вороново (возможно, название связано с болотной растительностью – шуварой. Это слово есть в словаре В. Даля. Т. 4. С. 1480)]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.99502490697159,56.045226658849344</coordinates></Point></Placemark><Placemark><name><![CDATA[182 Лысая гора (Горка)]]></name><description><![CDATA[на которой расположена деревня Старое сельцо. Название деревни осталось от тех пор, когда здесь жили помещики Мячковы и были их дома, было сельцо]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97936080632446,56.02677466919085</coordinates></Point></Placemark><Placemark><name><![CDATA[11 Мухановская лесопилка]]></name><description><![CDATA[по владельцу]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.00791292128756,56.03775112665986</coordinates></Point></Placemark><Placemark><name><![CDATA[61 Тимонино]]></name><description><![CDATA[за д. Родионово, там когда-то жили старообрядцы]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.95584639415162,55.98652487055246</coordinates></Point></Placemark><Placemark><name><![CDATA[121 Новая деревня]]></name><description><![CDATA[часть д. Родионово]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.953754271122186,55.985472366563585</coordinates></Point></Placemark><Placemark><name><![CDATA[120 Золотая середина]]></name><description><![CDATA[часть Родионово, место игры в футбол, гулянок и просмотра кино]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.948647345156,55.98756532046376</coordinates></Point></Placemark><Placemark><name><![CDATA[119	Чертов конец]]></name><description><![CDATA[в д. Родионово (низинка к Крыночкам)]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.957123125644905,55.98868392315937</coordinates></Point></Placemark><Placemark><name><![CDATA[122	Крыночки]]></name><description><![CDATA[ритуальное место по дороге на кладбище, где оставляли горшочки, из которых обмывали покойника. Это место для правобережных деревень]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.958582247349,55.98870196484895</coordinates></Point></Placemark><Placemark><name><![CDATA[69 Филимонова]]></name><description><![CDATA[речка]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96281477317363,55.990776703088045</coordinates></Point></Placemark><Placemark><name><![CDATA[124	Филимонов луг]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.970067466349775,55.990734607862166</coordinates></Point></Placemark><Placemark><name><![CDATA[14а	Вороновская река]]></name><description><![CDATA[продолжение Старой реки]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97036787375928,55.99400585510527</coordinates></Point></Placemark><Placemark><name><![CDATA[129	Кудринский луг]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97802826270665,55.993410558253466</coordinates></Point></Placemark><Placemark><name><![CDATA[25 Ганин ручей]]></name><description><![CDATA[Ганя]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.98045297965572,55.99446284674451</coordinates></Point></Placemark><Placemark><name><![CDATA[139 Вшивая горка]]></name><description><![CDATA[у Ганина ручья (это песчаный курган высотой 10 м, один из трех по Киржачу, где будто бы зарыты Золотые ворота г. Владимира. Второй курган был у ур. Быки, третий – у ур. Заплетень. Слово «вшивый» означает пренебрежение]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.98372527465445,55.99437866520734</coordinates></Point></Placemark><Placemark><name><![CDATA[26 Третной]]></name><description><![CDATA[ур., луг?]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97872563705041,55.99804642675442</coordinates></Point></Placemark><Placemark><name><![CDATA[117 Круглая лядка/Песочная горочка]]></name><description><![CDATA[лес посреди Среднего поля; до войны здесь добывали торф<br/>]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.94832011565687,55.992009465611105</coordinates></Point></Placemark><Placemark><name><![CDATA[118 Заплетень]]></name><description><![CDATA[луг за старицей Киржача. Между старицей и мостом был плетень, изгородь, загон для лошадей в ночное время. Старицу во время мелиоративных работ уничтожили. В омутках водились караси, щуки, вьюны]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.951753343195975,55.99262282537482</coordinates></Point></Placemark><Placemark><name><![CDATA[46 Подберезное]]></name><description><![CDATA[Лес]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.933057684233006,55.99168626874403</coordinates></Point></Placemark><Placemark><name><![CDATA[126 Ляда]]></name><description><![CDATA[Лес]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.93168439321942,55.98829454556162</coordinates></Point></Placemark><Placemark><name><![CDATA[45 Родионовская ляда]]></name><description><![CDATA[лес по низине]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.938722509674456,55.98498672495181</coordinates></Point></Placemark><Placemark><name><![CDATA[59 Раменье]]></name><description><![CDATA[поле и лес]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.958291906646814,55.98248462066033</coordinates></Point></Placemark><Placemark><name><![CDATA[62 Грива]]></name><description><![CDATA[лес по холму вытянутой формы, напоминает лошадиную холку, отсюда и название]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97914876394639,55.98639408673905</coordinates></Point></Placemark><Placemark><name><![CDATA[60 Завал]]></name><description><![CDATA[лес]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97243251257368,55.982496650663904</coordinates></Point></Placemark><Placemark><name><![CDATA[138 Задняя]]></name><description><![CDATA[сенокос]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.98672332220501,55.982159816677175</coordinates></Point></Placemark><Placemark><name><![CDATA[27 Змеевник]]></name><description><![CDATA[болото, луг, лес, упирается в покос Бык]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.990199465086874,55.978719128354925</coordinates></Point></Placemark><Placemark><name><![CDATA[63 Лучка]]></name><description><![CDATA[луг]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.99846066885351,55.977973204886645</coordinates></Point></Placemark><Placemark><name><![CDATA[137	Мокрый бык]]></name><description><![CDATA[низинка, может быть, контуры болота напоминали быка]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97642363958608,55.97981543559802</coordinates></Point></Placemark><Placemark><name><![CDATA[93 Усадьба Баскакова]]></name><description><![CDATA[в д. Лачуги. Известен как строительный подрядчик, застроивший улицу в Москве в районе Таганки. Построил в Лачугах часовню, частично сохранившуюся, сейчас там магазин, и школу. Дом Баскакова не сохранился]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.974628667737406,55.96696225721328</coordinates></Point></Placemark><Placemark><name><![CDATA[28 Зубовка]]></name><description><![CDATA[теперь часть д. Красный луч (Лачуги)]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97278330793515,55.96862901122897</coordinates></Point></Placemark><Placemark><name><![CDATA[88 Куриная (Курья) гора]]></name><description><![CDATA[часть д. Лачуги. От нее в сторону с. Санино идет дорога через Курью гору. Здесь был постоялый двор, пользовавшийся дурной славой]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.980829934977066,55.967768564561595</coordinates></Point></Placemark><Placemark><name><![CDATA[29 Лачужка]]></name><description><![CDATA[речка]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.003671626950485,55.97226312734304</coordinates></Point></Placemark><Placemark><name><![CDATA[86 Матреновка]]></name><description><![CDATA[часть д. Лачуги к ж/д станции «168 км.»]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.97006891241181,55.96474181217057</coordinates></Point></Placemark><Placemark><name><![CDATA[112 Старый исчезнувший деревянный мост]]></name><description><![CDATA[через р. Киржач у церкви]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.992068390750916,55.992187511397475</coordinates></Point></Placemark><Placemark><name><![CDATA[113	Нынешний висячий мост]]></name><description><![CDATA[через р. Киржач у бывшей церкви, «лавы»]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.995882491971116,55.99118627629057</coordinates></Point></Placemark><Placemark><name><![CDATA[8 Попов луг]]></name><description><![CDATA[теперь бор, шел по р. Киржач от церкви к Еловицам]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.994047861004795,55.99513394267578</coordinates></Point></Placemark><Placemark><name><![CDATA[9 Перерва]]></name><description><![CDATA[луг, по дороге из Барскова к Киржачу, на левом берегу]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.991798262371766,56.00364072535738</coordinates></Point></Placemark><Placemark><name><![CDATA[10 Долгий луг]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.023890342405544,56.0105810471627</coordinates></Point></Placemark><Placemark><name><![CDATA[2 Загрязье]]></name><description><![CDATA[болото со стороны Барсково, торфоразработки]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.02796730010817,56.00555595827354</coordinates></Point></Placemark><Placemark><name><![CDATA[23 Барсковские отруба]]></name><description><![CDATA[давались в 1918 г. по едокам]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.006123389890895,56.01142250506618</coordinates></Point></Placemark><Placemark><name><![CDATA[123 Кривая береза]]></name><description><![CDATA[такое же ритуальное место, где оставляли горшочки, из которых обмывали покойника, по дороге к Аргуновской церкви жители левобережных деревень. Это место по левую сторону дороги от Цепнино к Аргуново, сразу после поворота дороги к церкви]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.008397903135105,56.00166046153786</coordinates></Point></Placemark><Placemark><name><![CDATA[24 Бараши]]></name><description><![CDATA[Барашево, лес по болоту, раньше пустошь – лес, пашня, сенокос (возможно, по названию болотной птицы из семейства куликов, бекасов, в народе «барашек, баранчик» из-за блеянья. В. Даль. Т. 1. С. 120)]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.010307635953595,55.99581647689262</coordinates></Point></Placemark><Placemark><name><![CDATA[143	Протомоя]]></name><description><![CDATA[Протомойка, ручей от Цепнино в сторону Барскова, покос по болоту, трава хорошая. Покос Протомой означает мокрый, это объясняется словом «портомой» – мокрые порты]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.01916965453875,55.99465599206945</coordinates></Point></Placemark><Placemark><name><![CDATA[142 Большой луг]]></name><description><![CDATA[от Цепнина в сторону Барскова]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.0202425381436,56.00128171072748</coordinates></Point></Placemark><Placemark><name><![CDATA[141Малый луг]]></name><description><![CDATA[от Цепнина в сторону Барскова]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.01824697463737,56.00518926900142</coordinates></Point></Placemark><Placemark><name><![CDATA[162 Гора]]></name><description><![CDATA[ур. за д. Цепнино по дороге в Панфилово]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.03288110702318,55.99423508215946</coordinates></Point></Placemark><Placemark><name><![CDATA[114 Александровская ж/д]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.87803227000793,56.02494894221396</coordinates></Point></Placemark><Placemark><name><![CDATA[115 Среднее поле]]></name><description><![CDATA[В сторону Санино]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.94023806148052,55.98812487811125</coordinates></Point></Placemark><Placemark><name><![CDATA[116 Заднее поле]]></name><description><![CDATA[В сторону Лачуг.<br/>Здесь в 1918 г довали отруба по количеству едоков]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.94719034724625,55.98349382856302</coordinates></Point></Placemark><Placemark><name><![CDATA[Бараши, Барашово]]></name><description><![CDATA[Лес по болоту, раньше пустошь — лес, пашня, сенокос (возможно по названию болотной птицы из семейства куликов, бекасов, в народе "барашек, баранчик" из-за блеянья В. Даль]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.00642425113245,55.99829894812822</coordinates></Point></Placemark><Placemark><name><![CDATA[185 Два родника]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.977198115228326,56.02403712708044</coordinates></Point></Placemark><Placemark><name><![CDATA[183 Лавы через р. Молодынь]]></name><description><![CDATA[Лавы чуть ниже бывшей мельницы. А ниже лав р. Маленькая, которая заросла, но следы ее еще видны в половодье ниже учтья р. Молодыни. От лав идет дорога к с. Ильинскому, к церкви и кладбищу. Здесь же Ильинский омут]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.966699949144605,56.0185540932175</coordinates></Point></Placemark><Placemark><name><![CDATA[179 Курманка, старица Киржача]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96960746371611,56.0124632520292</coordinates></Point></Placemark><Placemark><name><![CDATA[52 Мельница Курманка]]></name><description><![CDATA[Бывшая мельница Курманка, располагалась в 300-400 м от устья р. Молодыни, притока р. Киржач. Здесь же Верхний и Нижний омут, выше и ниже плотины, отсюда и названия. Курман — старинное имя.]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.967643101129845,56.01953378233812</coordinates></Point></Placemark><Placemark><name><![CDATA[189 Наполдни]]></name><description><![CDATA[Место отдыха и дойки коров в летний день]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96398555362218,56.02435557087325</coordinates></Point></Placemark><Placemark><name><![CDATA[190 Конная порубка]]></name><description><![CDATA[Расположена в 400 м за Садовой прудкой. Прудка, выложенная камнями, к которой вели две сохранившиеся липовые аллеи от исчезнувшего барсокого дома, ликвидирована в 1930-ые, когда камень увезли для хоз.нужд]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.971324077486926,56.02437960417381</coordinates></Point></Placemark><Placemark><name><![CDATA[164 Сеча, луг]]></name><description><![CDATA[Луг у д. Старое Сельцо]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96523009860507,56.027768149169844</coordinates></Point></Placemark><Placemark><name><![CDATA[167 р. Молодынь (Молодань, Маловань, Моловань)]]></name><description><![CDATA[В Старом Сельце речку зовут Ильинской, а в с. Ильинском — Старосельской. Часть реки от мельницы до устья раньше называли Маленькой речкой]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.971731773256344,56.034592396553435</coordinates></Point></Placemark><Placemark><name><![CDATA[165 Гладыши (Гладкий) луг]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.983039966463494,56.036286256535014</coordinates></Point></Placemark><Placemark><name><![CDATA[186 Часовня]]></name><description><![CDATA[Современная часовня восстановленная там же М.И и Е.А. Ефимовыми, и рядом с ней следы Каменицы]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.981580844758355,56.02483623276952</coordinates></Point></Placemark><Placemark><name><![CDATA[177 Александров отруб]]></name><description><![CDATA[Тетки Татьяны отруб, Коротков отруб (давали в 1918 г., хотя некоторые думают, что в Столыпинскую реформу). Это место называлось Синие камни, в сторону Гладышей]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.98784648501866,56.03017119154111</coordinates></Point></Placemark><Placemark><name><![CDATA[173 Новая угольница]]></name><description><![CDATA[Здесь жгли уголь для промышленности, был своего рода местный промысел в последнюю войну и после нее]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.98986350619786,56.03531319758904</coordinates></Point></Placemark><Placemark><name><![CDATA[191Чухомский (Чухонский) омут]]></name><description><![CDATA[Омут на р. Молодынь]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.984971156953456,56.041103136935774</coordinates></Point></Placemark><Placemark><name><![CDATA[171 Горелая порубка, лес]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.99296413981887,56.042598530396035</coordinates></Point></Placemark><Placemark><name><![CDATA[172 Сорокарублевая порубка, лес]]></name><description><![CDATA[Существует предание, что старосельские мужики выкупили её у барина за 40 рулей]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.991505018114644,56.03839446713502</coordinates></Point></Placemark><Placemark><name><![CDATA[192 Круглый омут на р. Молодыни]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.967086187240604,56.01917604207384</coordinates></Point></Placemark><Placemark><name><![CDATA[178 Заболонье]]></name><description><![CDATA[Луг в междуречье Киржача и Молодыни. Принадлжеал Старому сельцу. Болонье — низменная луговая равнина у реки или озера; выгон, толока, поскотина (В. Даль. т. 1 с. 242)]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.948975911974124,56.023712674117725</coordinates></Point></Placemark><Placemark><name><![CDATA[135 Каменка]]></name><description><![CDATA[ПУстошь, болото]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.938332906603186,56.01635765531496</coordinates></Point></Placemark><Placemark><name><![CDATA[14 Старый Киржач, Старая река]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.9141286524533,56.03649648238718</coordinates></Point></Placemark><Placemark><name><![CDATA[180 граница Петушинского и Киржачского районов Владимирской области]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.921120060208686,56.01060463347032</coordinates></Point></Placemark><Placemark><name><![CDATA[39 Трубы, лес]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.93064726662957,56.01125375936346</coordinates></Point></Placemark><Placemark><name><![CDATA[14 Старый Киржач, Старая река]]></name><description><![CDATA[Имеет выятнутую форму, старица р. Киржач]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.93792141747797,56.00610853496478</coordinates></Point></Placemark><Placemark><name><![CDATA[54 Догадка, озеро]]></name><description><![CDATA[Бывшая старица (озеро до "гати")]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.94723404717732,56.01365783364581</coordinates></Point></Placemark><Placemark><name><![CDATA[43 оз. Неверово]]></name><description><![CDATA[Отсоединилось от оз. Догадка в сторону с. Санино<br/>заводка]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.95661104989242,56.003619825832544</coordinates></Point></Placemark><Placemark><name><![CDATA[38 Селепено, лес]]></name><description><![CDATA[Сосоновый строевой лес для изб]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.95577420068104,56.00945060479746</coordinates></Point></Placemark><Placemark><name><![CDATA[55 Осик (Осек)]]></name><description><![CDATA[Заливной луг у оз. Догадка]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.95925034356383,56.006541336906245</coordinates></Point></Placemark><Placemark><name><![CDATA[128 Ляда, лес]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96757592034515,55.998774197307306</coordinates></Point></Placemark><Placemark><name><![CDATA[65 Клабыково (от Каблуково)]]></name><description><![CDATA[Луг, круглый как каблук]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.95834912133448,55.99701855912131</coordinates></Point></Placemark><Placemark><name><![CDATA[37 Клин, луг]]></name><description><![CDATA[Здесь же подвесной мост через оз. Догадка]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.95186890435528,56.012095202479905</coordinates></Point></Placemark><Placemark><name><![CDATA[166 Долинка]]></name><description><![CDATA[Низинка у Старого Сельца в сторону Воронова]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.014240242102765,56.01980100531216</coordinates></Point></Placemark><Placemark><name><![CDATA[21 Иванково, луг, лес]]></name><description><![CDATA[Рядом с Мухановской порубкой, левее д. Вороново]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.00986287698989,56.020425940123076</coordinates></Point></Placemark><Placemark><name><![CDATA[168 Шубара]]></name><description><![CDATA[Болото от р. Молодыни в сторону Воронова. Возможно, название связано с болотной растительностью - шуварой (словарь Даля т.4 с. 1480)]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.02960393533831,56.03916926564755</coordinates></Point></Placemark><Placemark><name><![CDATA[169 Дунин лес]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.993018604377184,56.02343087982726</coordinates></Point></Placemark><Placemark><name><![CDATA[170 Захряпин лес]]></name><description><![CDATA[Название либо от глагола "захряпнуть", то есть заглохнуть, порасти сорными травами, стать непроходимим. В. Даль т. 1 с. 1649. Либо от глагола "захрять", залядеть, задернеть. Там же.]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>39.01132199869424,56.02591830619052</coordinates></Point></Placemark><Placemark><name><![CDATA[100 Грошев отруб]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96653983698306,55.96103583435916</coordinates></Point></Placemark><Placemark><name><![CDATA[105 Лошадиное кладбище]]></name><description><![CDATA[у ж/д станции "пл. 168 км"]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96344993219752,55.964117038190906</coordinates></Point></Placemark><Placemark><name><![CDATA[127 Глинищи]]></name><description><![CDATA[Здесь брали глину для печей]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.96181347487479,55.97546935929849</coordinates></Point></Placemark><Placemark><name><![CDATA[66 Репище, лес]]></name><description/><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yunits="insetPixels"/></IconStyle></Style><Point><coordinates>38.9392456780474,55.98072241385819</coordinates></Point></Placemark><Placemark><name><![CDATA[67 Мочина, лес]]></name><description><![CDATA[Название говорит о низкой, болотистой местности, ср. мочижина]]></description><Style><IconStyle><color>ffff981e</color><Icon><href>https://api-maps.yandex.ru/i/0.4/micro/pmbls.png</href></Icon><hotSpot x="7" y="28" xunits="pixels" yu